---
import Layout from '../layouts/Layout.astro';
import settings from '../data/settings.json';

// Content collections
const profileEntries = await Astro.glob('../content/profile.md');
const profile = profileEntries[0]?.frontmatter ?? {};

const projectEntries = await Astro.glob('../content/projects/*.md');
const sortedProjects = projectEntries
  .filter(p => p.frontmatter.title)
  .sort((a, b) => (a.frontmatter.order ?? 99) - (b.frontmatter.order ?? 99));

const linkEntries = await Astro.glob('../content/links/*.md');
const socialLinks = linkEntries
  .filter(l => l.frontmatter.name)
  .sort((a, b) => (a.frontmatter.order ?? 99) - (b.frontmatter.order ?? 99));
---

<Layout title="Tizone - Parsa Alemahmoud | Video Editor & Director">

  <!-- Navigation -->
  <nav class="nav" id="main-nav">
    <div class="nav-inner">
      <a href="/" class="nav-logo">TIZONE</a>
      <ul class="nav-links" id="nav-links">
        <li><a href="#home" class="nav-link active" data-section="home">Home</a></li>
        <li><a href="#projects" class="nav-link" data-section="projects">Projects</a></li>
        <li><a href="#contact" class="nav-link" data-section="contact">Contact</a></li>
      </ul>
      <button class="nav-toggle" id="nav-toggle" aria-label="Toggle menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>

  <main>
    <!-- Hero Section -->
    <section class="hero" id="home">
      <div class="hero-bg">
        <div class="hero-bg-orb hero-bg-orb-1"></div>
        <div class="hero-bg-orb hero-bg-orb-2"></div>
        <div class="hero-bg-orb hero-bg-orb-3"></div>
      </div>
      <!-- Canvas particles injected by JS -->
      <div class="hero-line"></div>

      <div class="hero-content">
        <p class="hero-eyebrow">Video Editor & Director</p>
        <h1 class="hero-title">
          <span class="line">
            <span>{profile.name?.split(' ')[0] || 'Parsa'}</span>
          </span>
          <span class="line">
            <span class="hero-title-accent">{profile.name?.split(' ')[1] || 'Alemahmoud'}</span>
          </span>
        </h1>
        <p class="hero-subtitle">{profile.tagline}</p>
        <div class="hero-cta">
          <a href="#projects" class="btn btn-primary magnetic">View Work</a>
          <a href="#contact" class="btn btn-outline magnetic">Contact</a>
        </div>
      </div>

      <div class="hero-scroll">
        <span class="hero-scroll-text">Scroll</span>
        <div class="hero-scroll-line"></div>
      </div>
    </section>

    <!-- Stats -->
    <div class="container">
      <div class="stats reveal">
        <div class="stat">
          <div class="stat-number text-accent">50+</div>
          <div class="stat-label">Projects</div>
        </div>
        <div class="stat">
          <div class="stat-number text-accent">5+</div>
          <div class="stat-label">Years</div>
        </div>
        <div class="stat">
          <div class="stat-number text-accent">30+</div>
          <div class="stat-label">Clients</div>
        </div>
      </div>
    </div>

    <!-- Projects Section -->
    <section class="projects section" id="projects">
      <div class="container">
        <div class="projects-header reveal">
          <h2 class="projects-title heading">Featured <span class="text-gradient">Projects</span></h2>
          <p class="projects-subtitle">A selection of recent work in video editing, direction, and creative production.</p>
        </div>

        <div class="filter-pills reveal" style="margin-bottom: var(--space-3xl);">
          <button class="filter-pill active" data-filter="all">All Work</button>
          <button class="filter-pill" data-filter="music-video">Music Videos</button>
          <button class="filter-pill" data-filter="commercial">Commercial</button>
          <button class="filter-pill" data-filter="film">Film</button>
        </div>

        <div class="projects-grid kinetic-stagger">
          {sortedProjects.map((project, index) => (
            <div class={`kinetic-card card reveal idle ${index === 0 ? 'card-featured' : ''}`} data-tags={project.frontmatter.tags?.join(',') || ''}>
              <div class="kinetic-card-inner">
                <div class="kinetic-card-shine"></div>
                <div class="card-media">
                  <iframe
                    src={`https://www.youtube.com/embed/${project.frontmatter.videoId}?rel=0`}
                    title={project.frontmatter.title}
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                    loading="lazy"
                  ></iframe>
                </div>
                <div class="card-body">
                  <h3 class="card-title">{project.frontmatter.title}</h3>
                  <p class="card-desc">{project.frontmatter.description}</p>
                  {project.frontmatter.tags && (
                    <div class="card-tags">
                      {project.frontmatter.tags.map((tag: string) => (
                        <span class="tag">{tag}</span>
                      ))}
                    </div>
                  )}
                </div>
              </div>
              <div class="kinetic-card-shadow"></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section class="contact section" id="contact">
      <div class="container">
        <div class="contact-header reveal">
          <h2 class="contact-title heading">Get in <span class="text-gradient">Touch</span></h2>
          <p class="contact-subtitle">Have a project in mind? Let's create something amazing together.</p>
        </div>

        <div class="contact-content">
          <div class="contact-info reveal">
            <div class="contact-info-item">
              <div class="contact-info-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                </svg>
              </div>
              <div>
                <div class="contact-info-label">Email</div>
                <div class="contact-info-value">{settings.contactEmail || profile.email}</div>
              </div>
            </div>
            <div class="contact-info-item">
              <div class="contact-info-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
              </div>
              <div>
                <div class="contact-info-label">Phone</div>
                <div class="contact-info-value">{settings.contactPhone || profile.phone}</div>
              </div>
            </div>
            <div class="contact-info-item">
              <div class="contact-info-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
                </svg>
              </div>
              <div>
                <div class="contact-info-label">Location</div>
                <div class="contact-info-value">{settings.contactLocation || profile.location}</div>
              </div>
            </div>
          </div>

          <form class="contact-form reveal" action={`mailto:${settings.contactEmail || profile.email}`} method="POST" enctype="text/plain">
            <div class="form-group">
              <label class="form-label" for="name">Name</label>
              <input class="form-input" type="text" id="name" name="name" required placeholder="Your name">
            </div>
            <div class="form-group">
              <label class="form-label" for="email">Email</label>
              <input class="form-input" type="email" id="email" name="email" required placeholder="your@email.com">
            </div>
            <div class="form-group">
              <label class="form-label" for="message">Message</label>
              <textarea class="form-textarea" id="message" name="message" required placeholder="Tell me about your project..."></textarea>
            </div>
            <button type="submit" class="btn btn-primary magnetic" style="width: 100%;">
              Send Message
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="m22 2-11 11"/></svg>
            </button>
          </form>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="social-links" style="margin-bottom: var(--space-lg);">
        {socialLinks.map(link => (
          <a href={link.frontmatter.url} target="_blank" rel="noopener noreferrer" class="social-link" aria-label={link.frontmatter.name}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d={link.frontmatter.icon} />
            </svg>
          </a>
        ))}
      </div>
      <p class="footer-text">&copy; {new Date().getFullYear()} {settings.siteName}. {settings.footerText}</p>
    </div>
  </footer>

  <!-- Client-side scripts -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {

      // ============================================
      // HERO PARTICLE SYSTEM
      // ============================================
      const hero = document.querySelector('.hero');
      if (hero) {
        const canvas = document.createElement('canvas');
        canvas.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:0;';
        hero.insertBefore(canvas, hero.firstChild);
        const ctx = canvas.getContext('2d');

        function resizeCanvas() {
          canvas.width = hero.offsetWidth;
          canvas.height = hero.offsetHeight;
        }
        resizeCanvas();
        window.addEventListener('resize', resizeCanvas);

        const particles = Array.from({length: 50}, () => ({
          x: Math.random() * canvas.width,
          y: Math.random() * canvas.height,
          vx: (Math.random() - 0.5) * 0.3,
          vy: (Math.random() - 0.5) * 0.3,
          size: Math.random() * 2 + 0.5,
          opacity: Math.random() * 0.4 + 0.1,
          pulse: Math.random() * Math.PI * 2
        }));

        let mouseX = canvas.width / 2;
        let mouseY = canvas.height / 2;

        hero.addEventListener('mousemove', (e) => {
          const rect = hero.getBoundingClientRect();
          mouseX = e.clientX - rect.left;
          mouseY = e.clientY - rect.top;
        });

        function animateParticles() {
          ctx.clearRect(0, 0, canvas.width, canvas.height);

          particles.forEach(p => {
            p.x += p.vx;
            p.y += p.vy;
            p.pulse += 0.02;

            // Wrap around
            if (p.x < 0) p.x = canvas.width;
            if (p.x > canvas.width) p.x = 0;
            if (p.y < 0) p.y = canvas.height;
            if (p.y > canvas.height) p.y = 0;

            // Mouse influence
            const dx = mouseX - p.x;
            const dy = mouseY - p.y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < 200) {
              p.vx += dx * 0.00005;
              p.vy += dy * 0.00005;
            }

            // Damping
            p.vx *= 0.999;
            p.vy *= 0.999;

            const alpha = p.opacity * (0.5 + Math.sin(p.pulse) * 0.5);
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(41, 151, 255, ${alpha})`;
            ctx.fill();
          });

          // Draw connections
          for (let i = 0; i < particles.length; i++) {
            for (let j = i + 1; j < particles.length; j++) {
              const dx = particles[i].x - particles[j].x;
              const dy = particles[i].y - particles[j].y;
              const dist = Math.sqrt(dx * dx + dy * dy);
              if (dist < 120) {
                ctx.beginPath();
                ctx.moveTo(particles[i].x, particles[i].y);
                ctx.lineTo(particles[j].x, particles[j].y);
                ctx.strokeStyle = `rgba(41, 151, 255, ${0.08 * (1 - dist / 120)})`;
                ctx.lineWidth = 0.5;
                ctx.stroke();
              }
            }
          }

          requestAnimationFrame(animateParticles);
        }
        animateParticles();
      }

      // Mobile nav toggle
      const navToggle = document.getElementById('nav-toggle');
      const navLinks = document.getElementById('nav-links');

      navToggle?.addEventListener('click', () => {
        navLinks.classList.toggle('open');
      });

      navLinks?.querySelectorAll('.nav-link').forEach(link => {
        link.addEventListener('click', () => {
          navLinks.classList.remove('open');
        });
      });

      // Active nav link on scroll
      const sections = document.querySelectorAll('section[id]');
      const navLinkEls = document.querySelectorAll('.nav-link[data-section]');

      const sectionObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            navLinkEls.forEach(link => {
              link.classList.toggle('active', link.dataset.section === entry.target.id);
            });
          }
        });
      }, { rootMargin: '-20% 0px -80% 0px' });

      sections.forEach(section => sectionObserver.observe(section));

      // Scroll reveal
      const revealElements = document.querySelectorAll('.reveal');
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      }, { threshold: 0.1 });

      revealElements.forEach(el => revealObserver.observe(el));

      // ============================================
      // KINETIC 3D CARD TILT
      // ============================================
      document.querySelectorAll('.kinetic-card').forEach(card => {
        const inner = card.querySelector('.kinetic-card-inner');
        const shadow = card.querySelector('.kinetic-card-shadow');
        if (!inner) return;

        let targetRX = 0, targetRY = 0, targetTZ = 0;
        let curRX = 0, curRY = 0, curTZ = 0;
        let hovering = false;
        let raf = null;

        function tick() {
          if (!hovering) { targetRX = 0; targetRY = 0; targetTZ = 0; }

          curRX += (targetRX - curRX) * 0.1;
          curRY += (targetRY - curRY) * 0.1;
          curTZ += (targetTZ - curTZ) * 0.1;

          inner.style.transform = `perspective(800px) rotateX(${curRX}deg) rotateY(${curRY}deg) translateZ(${curTZ}px) scale(${hovering ? 1.06 : 1})`;

          if (shadow) {
            shadow.style.transform = `translateX(${-curRY * 4}px) scaleX(${1 + Math.abs(curRY) * 0.015})`;
            shadow.style.opacity = hovering ? '0.2' : '0.6';
          }

          const close = Math.abs(targetRX - curRX) > 0.05 || Math.abs(targetRY - curRY) > 0.05;
          if (close || hovering) raf = requestAnimationFrame(tick);
          else raf = null;
        }

        card.addEventListener('mousemove', (e) => {
          hovering = true;
          card.classList.remove('idle');
          const r = card.getBoundingClientRect();
          targetRX = ((e.clientY - r.top) / r.height - 0.5) * -35;
          targetRY = ((e.clientX - r.left) / r.width - 0.5) * 35;
          targetTZ = 50;
          if (!raf) raf = requestAnimationFrame(tick);
        });

        card.addEventListener('mouseleave', () => {
          hovering = false;
          setTimeout(() => { if (!hovering) card.classList.add('idle'); }, 600);
        });

        card.addEventListener('mouseenter', () => {
          if (raf) cancelAnimationFrame(raf);
          raf = requestAnimationFrame(tick);
        });
      });

      // Filter pills
      const filterPills = document.querySelectorAll('.filter-pill');
      const projectCards = document.querySelectorAll('.card[data-tags]');

      filterPills.forEach(pill => {
        pill.addEventListener('click', () => {
          filterPills.forEach(p => p.classList.remove('active'));
          pill.classList.add('active');
          const filter = pill.dataset.filter;
          projectCards.forEach(card => {
            if (filter === 'all') {
              card.style.display = '';
            } else {
              card.style.display = (card.dataset.tags || '').includes(filter) ? '' : 'none';
            }
          });
        });
      });

      // Smooth scroll
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', (e) => {
          e.preventDefault();
          const target = document.querySelector(anchor.getAttribute('href'));
          if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });

      // Navbar scroll
      const nav = document.getElementById('main-nav');
      window.addEventListener('scroll', () => {
        nav.classList.toggle('scrolled', window.scrollY > 50);
      });
    });
  </script>
</Layout>
